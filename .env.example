# Telegram Bot Configuration
# 1. Create a bot via @BotFather on Telegram and paste the token here:
TELEGRAM_BOT_TOKEN=

# 2. (Optional) Your Telegram Chat ID.
# If left empty, simply send /start to your bot in Telegram and it will
# display your Chat ID and automatically subscribe your chat!
TELEGRAM_CHAT_ID=

# LEGO Region / Locale (en-PL corresponds to https://www.lego.com/en-pl/insiders/rewards)
LEGO_LOCALE=en-PL

# Local timezone for displaying release dates & scheduling midnight drop boosts
TIMEZONE=Europe/Warsaw

# Standard polling interval during regular hours (in minutes)
POLL_INTERVAL_MINUTES=15

# Fast polling interval during the midnight release window (23:55-00:30 & 00:55-01:15 Europe/Warsaw)
MIDNIGHT_BOOST_INTERVAL_SECONDS=90

# Send a welcome message + the #1 newest reward card when initializing for the first time
NOTIFY_ON_FIRST_RUN=true

# Path to persistent state file
STATE_FILE=data/rewards_state.json
